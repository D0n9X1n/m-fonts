# Pinned upstream releases. scripts/fetch-sources.sh downloads these into
# sources/; scripts/check-updates.sh reports newer releases.

# https://github.com/arrowtype/recursive/releases
RECURSIVE_VERSION=1.085

# Anthropic Serif Text by BSPK (name table version). No release feed; the
# files are pinned by SHA-256 in scripts/fetch-sources.sh.
ANTHROPIC_SERIF_VERSION=25.324

# https://github.com/CyanoHao/Resource-Han-Rounded/releases
RESOURCE_HAN_ROUNDED_VERSION=0.990

# https://github.com/ryanoasis/nerd-fonts/releases
NERD_FONTS_VERSION=3.5.1
